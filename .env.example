# ─── DevLens Lite · Environment Variables ─────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/devlens

# JWT  (generate with: node -e "require('crypto').randomBytes(64).toString('hex')|xargs echo")
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

# Gemini AI  (https://aistudio.google.com/app/apikey)
# Optional – without it, chat falls back to a simple rule-based responder.
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub API (https://github.com/settings/tokens) – optional.
# Public repos work without a token, but GitHub rate-limits unauthenticated
# requests to 60/hour. A token raises that to 5,000/hour.
GITHUB_TOKEN=

# Directory used to clone repositories locally (must be writable)
CLONE_DIR=/tmp/repos

# CORS – URL of the frontend
CLIENT_URL=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
